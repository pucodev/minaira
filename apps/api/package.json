{
  "name": "@minaira/api",
  "version": "0.1.0",
  "type": "module",
  "imports": {
    "#utils/*": "./src/core/utils/*.ts",
    "#config/*": "./src/core/config/*.ts",
    "#db/*": "./src/infra/db/*.ts",
    "#services/*": "./src/domain/services/*.ts",
    "#models/*": "./src/domain/models/*.ts",
    "#routes/*": "./src/api/v1/routes/*.ts"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.ts",
    "migrate": "node --env-file=.env src/infra/db/migrations.ts"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.1",
    "@fastify/postgres": "^6.0.1",
    "bcrypt": "^6.0.0",
    "fastify": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "pg-format": "^1.0.4",
    "pino": "^9.9.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10"
  }
}
