{
  "name": "minaira",
  "version": "1.0.0",
  "description": "Plataforma open-source y self-host para el agendamiento de citas en negocios de servicios",
  "homepage": "https://github.com/pucodev/minaira#readme",
  "bugs": {
    "url": "https://github.com/pucodev/minaira/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pucodev/minaira.git"
  },
  "author": "",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "pnpm --filter @minaira/api dev",
    "lint": "eslint .",
    "migrate:api": "pnpm --filter @minaira/api migrate",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,json,css,md,scss}": "prettier --write",
    "*.{js,ts}": "eslint --fix"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^2.10.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@tsconfig/node-ts": "^23.6.1",
    "@tsconfig/node22": "^22.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.2.1",
    "@types/pg": "^8.15.5",
    "@types/pg-format": "^1.0.5",
    "eslint": "^9.15.0",
    "eslint-plugin-jsdoc": "^50.4.3",
    "husky": "^9.1.7",
    "jest": "^30.1.1",
    "lint-staged": "^16.1.5",
    "neostandard": "^0.11.7",
    "pino-pretty": "^13.1.1",
    "prettier-plugin-packagejson": "^2.5.19",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2"
  }
}
